-- Cut: the upper IR every front end hands Meadow's back end (`docs/CUT.md`
-- in meadow), as a Lingua language, with what a front end builds a program
-- of it with and the text `meadow cut` reads. Nothing here knows any front
-- end: MeadowBoot lowers Meadow's core to it, and Idyll's front end its own.
--
-- Cut is a sequent calculus: a producer makes a value, a consumer receives
-- one, and a statement is one meeting the other. A program of it is a tree,
-- not a graph of blocks, so what builds one is not a cursor to write at but
-- a function of where a value goes: `shared`, `branch`, `applied`.

use Lingua (lang!)
use Lingua.Lang (Meta, spanMeta)
use Std.Collections.Vector as V
use Std.String as S
use Lingua.Buf as B
use Std.Char as C

-- --- the language ------------------------------------------------------------

@pub lang! {
  pub Cut
  File + File { entry : String, answer : String, decls : [Decl] }
  DataCtor + DataCtor { name : String, fields : [String] }
  Decl + Data { symbol : String, params : [String], ctors : [DataCtor] }
  Decl + Roles { roles : [String], ctors : [String] }
  Decl + Native { ops : [String], runtime : [String] }
  Decl + Source { symbol : String, path : String }
  Op + Op { name : String, params : [String], result : String, many : Bool }
  Decl + Effect { symbol : String, ops : [Op] }
  Decl + Val { symbol : String, title : String, rep : String, body : Stmt }
  Decl
    + Def {
      symbol : String,
      title : String,
      reps : [String],
      descs : [String],
      effects : [String],
      kinds : [String],
      params : [Param],
      conts : [Param],
      rowKnown : Bool,
      rowEffects : [String],
      rowVars : [String],
      body : Stmt
    }
  Param + Param { name : String, rep : String, shown : String, ty : String }
  Prod + Var { name : String }
  Prod + Sym { symbol : String }
  Prod + Int { value : Int }
  Prod + Float { value : Float }
  Prod + Char { code : Int }
  Prod + Str { text : String }
  Prod + Bool { value : Bool }
  Prod + Unit {}
  Prod + Desc { rep : String }
  Prod + Con { symbol : String, args : [Prod] }
  Prod + Tuple { items : [Prod] }
  Prod + Array { items : [Prod] }
  Prod + Record { labels : [String], values : [Prod] }
  Prod + Mu { k : String, body : Stmt }
  Prod + Cocase { methods : [Method] }
  Method
    + Method {
      name : String,
      title : String,
      params : [Param],
      conts : [Param],
      rowKnown : Bool,
      rowEffects : [String],
      rowVars : [String],
      body : Stmt
    }
  Cons + KVar { name : String }
  Cons + Halt {}
  Cons + MuT { name : String, rep : String, shown : String, ty : String, body : Stmt }
  Cons + Call { method : String, args : [Prod], conts : [Cons] }
  CaseArm + CaseArm { pattern : String, fields : [Param], body : Stmt }
  Cons + Case { arms : [CaseArm] }
  Stmt + Cut { prod : Prod, cons : Cons }
  Stmt + Invoke { symbol : String, args : [Prod], conts : [Cons] }
  Stmt + Prim { op : String, args : [Prod], conts : [Cons] }
  Stmt + Perform { op : String, args : [Prod], cont : Cons }
  Clause + Clause { op : String, params : [Param], resume : String, k : String, body : Stmt }
  Stmt
    + Handle {
      clauses : [Clause],
      ret : Param,
      retK : String,
      retBody : Stmt,
      bodyK : String,
      body : Stmt,
      cont : Cons
    }
  Stmt + Error { message : String }
  Stmt + At { source : String, start : Int, upto : Int, body : Stmt }
}

-- --- building ----------------------------------------------------------------
--
-- What a front end makes a program with. `out` is the program being
-- written, from `builder` to `finished`, and `m` where in the source what
-- is written came from. The tables under these are the language's own, and
-- nothing outside this module writes them directly.

@pub fun builder () = newCutBuilder ()

-- The program `out` holds, whose root is `root`.
@pub fun finished out root = CutProgram (freezeCut out) root

-- A program: the definition that runs, what becomes of its answer -- `none`
-- or `str` -- and its declarations.
@pub fun file out (m : Meta) (entry : String) (answer : String) decls =
  newCutFile out m entry answer decls

-- `data symbol <params> { ctors }`, each constructor its name and its
-- fields' representations.
@pub fun dataDecl out (m : Meta) (symbol : String) (params : [String]) ctors =
  newCutDeclData out m symbol params ctors

@pub fun ctorDecl out (m : Meta) (name : String) (fields : [String]) =
  newCutDataCtor out m name fields

-- `effect symbol { ops }`, each operation made with `opDecl`: its name, the
-- representations of what it takes, and that of what it is resumed with.
@pub fun effectDecl out (m : Meta) (symbol : String) ops = newCutDeclEffect out m symbol ops

@pub fun opDecl out (m : Meta) (name : String) (params : [String]) (result : String) =
  newCutOp out m name params result False

-- `@many name(params) -> result`: an operation a clause may resume more
-- than once, which makes its effect a `ManyEffect`.
@pub fun manyOpDecl out (m : Meta) (name : String) (params : [String]) (result : String) =
  newCutOp out m name params result True

-- `roles { role = symbol ... }`: which declared constructor plays each part
-- the runtime builds or recognises -- `nil`, `cons`, `some`, `ok`, ... -- as
-- (role, constructor) pairs.
@pub fun rolesDecl out (m : Meta) (roles : [(String, String)]) =
  newCutDeclRoles out m (V.map fst roles) (V.map snd roles)

-- `native { op = Effect.op ... }`: the runtime operation that performs each
-- operation the program leaves unhandled, as (operation, runtime operation)
-- pairs.
@pub fun nativeDecl out (m : Meta) (ops : [(String, String)]) =
  newCutDeclNative out m (V.map fst ops) (V.map snd ops)

-- `val symbol : rep = s`: computed once, what `s` gives to `halt`.
@pub fun valDecl out (m : Meta) (symbol : String) (rep : String) body =
  newCutDeclVal out m symbol "" rep body

-- `def symbol (params; conts) = s`.
@pub fun defDecl out (m : Meta) (symbol : String) params conts body =
  newCutDeclDef out m symbol "" [] [] [] [] params conts False [] [] body

-- `def symbol <'a = da, ...; e: Effect, ...> (params; conts) = s`: a
-- definition generic in how values are represented and in effects. `reps`
-- are (variable, descriptor parameter) pairs, whose parameters are among
-- `params` where the definition wants them; `effects` (variable, kind)
-- pairs, the kind `Effect` or `ManyEffect`.
@pub fun defWith
    out
    (m : Meta)
    (symbol : String)
    (reps : [(String, String)])
    (effects : [(String, String)])
    params
    conts
    body =
  newCutDeclDef
    out
    m
    symbol
    ""
    (V.map fst reps)
    (V.map snd reps)
    (V.map fst effects)
    (V.map snd effects)
    params
    conts
    False
    []
    []
    body

-- `defWith`, and what the definition may perform: its row, `! {E, .. | e,
-- ..}` -- the effects, by their declarations' symbols, and some of its own
-- effect variables (`docs/CUT.md`, "Rows"). A definition made without one
-- says nothing, and the back end assumes the worst of it.
@pub fun defWithRow
    out
    (m : Meta)
    (symbol : String)
    (reps : [(String, String)])
    (effects : [(String, String)])
    params
    conts
    (rowEffects : [String])
    (rowVars : [String])
    body =
  newCutDeclDef
    out
    m
    symbol
    ""
    (V.map fst reps)
    (V.map snd reps)
    (V.map fst effects)
    (V.map snd effects)
    params
    conts
    True
    rowEffects
    rowVars
    body

-- A method of an object, `name(params; conts) => s`; and one with a row,
-- as `defWithRow`'s, of the definition it is written in.
@pub fun method out (m : Meta) (name : String) params conts body =
  newCutMethod out m name "" params conts False [] [] body

@pub fun methodWithRow
    out
    (m : Meta)
    (name : String)
    params
    conts
    (rowEffects : [String])
    (rowVars : [String])
    body =
  newCutMethod out m name "" params conts True rowEffects rowVars body

-- An object of `methods`.
@pub fun cocase out (m : Meta) methods = newCutProdCocase out m methods

-- `def symbol <'a = da, ...> (da: desc, ..., params; conts) = s`: a
-- definition generic in how values are represented, a descriptor to each of
-- `reps` before what else it takes.
@pub fun genericDecl out (m : Meta) (symbol : String) (reps : [String]) params conts body =
  newCutDeclDef
    out
    m
    symbol
    ""
    reps
    (V.map (\r -> "d${r}") reps)
    []
    []
    (V.append (V.map (\r -> newCutParam out m "d${r}" "desc" "" "") reps) params)
    conts
    False
    []
    []
    body

-- `desc(rep)`: a representation's descriptor, a value.
@pub fun desc out (m : Meta) (rep : String) = newCutProdDesc out m rep

@pub fun param out (m : Meta) (name : String) (rep : String) = newCutParam out m name rep "" ""

-- Producers.
@pub fun var out (m : Meta) (name : String) = newCutProdVar out m name

@pub fun sym out (m : Meta) (symbol : String) = newCutProdSym out m symbol

@pub fun int out (m : Meta) (n : Int) = newCutProdInt out m n

@pub fun float out (m : Meta) (x : Float) = newCutProdFloat out m x

@pub fun char out (m : Meta) (code : Int) = newCutProdChar out m code

@pub fun str out (m : Meta) (s : String) = newCutProdStr out m s

@pub fun bool out (m : Meta) (b : Bool) = newCutProdBool out m b

@pub fun unit out (m : Meta) = newCutProdUnit out m

@pub fun con out (m : Meta) (symbol : String) args = newCutProdCon out m symbol args

@pub fun tuple out (m : Meta) items = newCutProdTuple out m items

@pub fun array out (m : Meta) items = newCutProdArray out m items

-- `record { l = p, ... }`: each label, and its value in the same place.
@pub fun recorded out (m : Meta) (labels : [String]) values = newCutProdRecord out m labels values

-- A function: codata with one method, `apply`, of one argument named `x`,
-- answering to the continuation named `k`.
@pub fun function out (m : Meta) (x : String) (rep : String) (k : String) body =
  newCutProdCocase out m [method out m "apply" [param out m x rep] [param out m k "ptr"] body]

-- `function`, with a row for its `apply`: see `defWithRow`.
@pub fun functionWithRow
    out
    (m : Meta)
    (x : String)
    (rep : String)
    (k : String)
    (rowEffects : [String])
    (rowVars : [String])
    body =
  newCutProdCocase
    out
    m
    [methodWithRow out m "apply" [param out m x rep] [param out m k "ptr"] rowEffects rowVars body]

-- Consumers.
@pub fun cont out (m : Meta) (name : String) = newCutConsKVar out m name

@pub fun halt out (m : Meta) = newCutConsHalt out m

-- `case { arms }`, each made with `arm`: a constructor's symbol, `#tuple`,
-- or `_`, the fields it binds, and what to do.
@pub fun caseOf out (m : Meta) arms = newCutConsCase out m arms

@pub fun arm out (m : Meta) (pattern : String) fields body = newCutCaseArm out m pattern fields body

-- Statements.
@pub fun give out (m : Meta) prod cons = newCutStmtCut out m prod cons

@pub fun invoke out (m : Meta) (symbol : String) args conts =
  newCutStmtInvoke out m symbol args conts

@pub fun prim out (m : Meta) (op : String) args conts = newCutStmtPrim out m op args conts

@pub fun fail out (m : Meta) (message : String) = newCutStmtError out m message

-- The field `label` of the record `r`, to `k`; and `r` with that field set,
-- or added, to `value`. A label is a name the back end is given, written as
-- text.
@pub fun selected out (m : Meta) r (label : String) k =
  newCutStmtPrim out m "select" [r, newCutProdStr out m label] [k]

@pub fun extended out (m : Meta) r (label : String) value k =
  newCutStmtPrim out m "extend" [r, newCutProdStr out m label, value] [k]

-- `perform op(args; k)`: `k` receives what the operation is resumed with.
@pub fun performed out (m : Meta) (op : String) args k = newCutStmtPerform out m op args k

-- A handler's clause for `op`: what it takes, the name of the resumption --
-- a function -- and the name of where the handler's own value goes.
@pub fun clause out (m : Meta) (op : String) params (resume : String) (k : String) body =
  newCutClause out m op params resume k body

-- `body` handled, the value of the whole to `k`: `body` is built with the
-- name of its own continuation, `bodyK`, which gives what it answers to the
-- `return` clause -- `returned`, with its value as `ret` and the handler's
-- continuation as `retK`.
@pub fun handled out (m : Meta) clauses ret (retK : String) returned (bodyK : String) body k =
  newCutStmtHandle out m clauses ret retK returned bodyK body k

@pub def nowhere : Meta = spanMeta 0 0

-- What a lowering has no words for yet: a statement that says so when it
-- runs, so that a program with one in it still reads.
@pub fun unsupported out (m : Meta) (what : String) = newCutStmtError out m "unsupported: ${what}"

-- What `build` makes with somewhere to send a value more than once: `k`
-- itself, if that is a name already, and otherwise a name for it -- `μ j. s`
-- given to `k` -- so that a consumer written once is not written again in
-- every branch.
@pub fun shared out k (m : Meta) (name : String) build =
  let kind = kindCutCons out k in
  if kind == CutConsKind.KVar or kind == CutConsKind.Halt then build k
  else newCutStmtCut out m (newCutProdMu out m name (build (newCutConsKVar out m name))) k

-- `no` or `yes`, by the truth `cond` is: a test's branches each receive
-- `unit`, which `name` is bound to, false first.
@pub fun branch out (m : Meta) (name : String) cond no yes =
  newCutStmtPrim out m "if" [cond] [
    newCutConsMuT out m name "unit" "" "" no,
    newCutConsMuT out m name "unit" "" "" yes
  ]

-- The function `f` given `arg`, its answer to `k`: a function is codata
-- with one method, `apply`.
@pub fun applied out (m : Meta) f arg k =
  newCutStmtCut out m f (newCutConsCall out m "apply" [arg] [k])

-- A value named `name`, of representation `rep`, for `rest`.
@pub fun binding out (m : Meta) (name : String) (rep : String) rest =
  newCutConsMuT out m name rep "" "" rest

-- `unit` given to the continuation `name`: how one arm of a match says it
-- did not, to whatever tries the next.
@pub fun gaveUp out (m : Meta) (name : String) =
  newCutStmtCut out m (newCutProdUnit out m) (newCutConsKVar out m name)

-- `first`, and `next` if it gives up: `first` is built with the name of the
-- continuation that giving up goes to.
@pub fun orElse out (m : Meta) (name : String) first next =
  newCutStmtCut
    out
    m
    (newCutProdMu out m name (first name))
    (newCutConsMuT out m "u_${name}" "unit" "" "" next)

-- --- what a debugger is told --------------------------------------------------
--
-- A program built to be debugged says where each of its statements was
-- written and what the source calls what it binds (`docs/CUT.md` in meadow,
-- "Positions and names"). None of it does anything: `meadow cut` takes it
-- off before it builds or runs a program, and a debugger reads it.

-- `source symbol = "path"`: a file positions are in, by the symbol they name
-- it by -- one of the front end's package, so that programs put together text
-- by text name their files apart.
@pub fun sourceDecl out (m : Meta) (symbol : String) (path : String) =
  newCutDeclSource out m symbol path

-- `@source:start-upto s`: `body`, written at bytes `start` to `upto` of the
-- file `source` names. A debugger stops before it.
@pub fun at out (m : Meta) (source : String) (start : Int) (upto : Int) body =
  newCutStmtAt out m source start upto body

-- A parameter, and a value bound for `rest`, that the source calls `shown`,
-- of type `ty` as the front end writes types: `name: rep @"shown" "ty"`. A
-- debugger shows the value by them.
@pub fun shownParam out (m : Meta) (name : String) (rep : String) (shown : String) (ty : String) =
  newCutParam out m name rep shown ty

@pub fun shownBinding
    out
    (m : Meta)
    (name : String)
    (rep : String)
    (shown : String)
    (ty : String)
    rest =
  newCutConsMuT out m name rep shown ty rest

-- A method that is the function the source calls `title`, as
-- `method` makes one: `apply @"mainLocal1"(params; conts) => s`, what a
-- debugger's stack shows a frame of its body as.
@pub fun titledMethod out (m : Meta) (name : String) (title : String) params conts body =
  newCutMethod out m name title params conts False [] [] body

-- `d`, a `val` or a `def`, said to be what the source calls `title`:
-- `def symbol @"title" ...`, what a debugger's stack shows it as. Anything
-- else is as it was.
@pub fun titled out (title : String) (d : CutDecl) =
  match viewCutDecl out d with
  | CutDeclView.Val r -> newCutDeclVal out (metaCutDecl out d) r.symbol title r.rep r.body
  | CutDeclView.Def r ->
      newCutDeclDef
        out
        (metaCutDecl out d)
        r.symbol
        title
        r.reps
        r.descs
        r.effects
        r.kinds
        r.params
        r.conts
        r.rowKnown
        r.rowEffects
        r.rowVars
        r.body
  | _ -> d

-- --- the text ----------------------------------------------------------------

-- A program as `meadow_cut::parse` reads it.
@pub fun text (p : CutProgram) : String = header p ++ body p

-- What a program's text opens with: its version, its entry, and what
-- becomes of its answer.
@pub fun header (p : CutProgram) : String =
  match p with
  | CutProgram a root -> "cut 0\nentry ${cutFileEntry a root}\nanswer ${cutFileAnswer a root}\n\n"

-- Its declarations. The text is written a piece at a time and joined once:
-- a statement holds the statements after it, as deep as the program is
-- long, so text made of its parts' text would copy each part once for every
-- level above it.
@pub fun body (p : CutProgram) : String =
  match p with
  | CutProgram a root ->
      runSt (\() ->
        let w = B.buffer () in
        let u = between w "\n" (\d -> decl w a d) (cutFileDecls a root) in
        concatStrings (B.freeze w))

-- Some of its declarations as text: each followed by a blank line.
@pub fun textOf (p : CutProgram) (decls : [CutDecl]) : String =
  match p with
  | CutProgram a _ ->
      runSt (\() ->
        let w = B.buffer () in
        let u = V.foldl (\x d -> (let y = decl w a d in put w "\n")) () decls in
        concatStrings (B.freeze w))

fun put w (text : String) = (let u = B.push w text in ())

-- Each of `xs` written by `each`, `sep` between them.
fun between w (sep : String) each xs =
  V.foldl
    (\first x ->
      (let u = if first then () else put w sep in
       let v = each x in
       False))
    True
    xs

fun decl w (a : CutArena) (d : CutDecl) =
  match viewCutDecl a d with
  | CutDeclView.Source r -> put w "source ${r.symbol} = ${quoted r.path}\n"
  | CutDeclView.Val r ->
      (let u = put w "val ${r.symbol}${titleText r.title} : ${r.rep} =\n  " in
       let v = stmt w a 1 r.body in
       put w "\n")
  | CutDeclView.Data r ->
      let taking = if V.isEmpty r.params then "" else " <${S.join ", " r.params}>" in
      let ctor =
        \c ->
          (let fs = cutDataCtorFields a c in
           if V.isEmpty fs then cutDataCtorName a c
           else "${cutDataCtorName a c}(${S.join ", " fs})")
      in put w "data ${r.symbol}${taking} { ${S.join "; " (V.map ctor r.ctors)} }\n"
  | CutDeclView.Effect r ->
      let op =
        \o ->
          (let many = if cutOpMany a o then "@many " else "" in
           "${many}${cutOpName a o}(${S.join ", " (cutOpParams a o)}) -> ${cutOpResult a o}")
      in put w "effect ${r.symbol} { ${S.join "; " (V.map op r.ops)} }\n"
  | CutDeclView.Roles r -> table w "roles" r.roles r.ctors
  | CutDeclView.Native r -> table w "native" r.ops r.runtime
  | CutDeclView.Def r ->
      (let reps = V.map (\x -> "'${fst x} = ${snd x}") (V.zip r.reps r.descs) in
       let effects = V.map (\x -> "${fst x}: ${snd x}") (V.zip r.effects r.kinds) in
       let reps =
         if V.isEmpty reps and V.isEmpty effects then ""
         else if V.isEmpty effects then "<${S.join ", " reps}> "
         else if V.isEmpty reps then "<${S.join ", " effects}> "
         else "<${S.join ", " reps}; ${S.join ", " effects}> "
       in
       let said = row r.rowKnown r.rowEffects r.rowVars in
       let u =
         put
           w
           "def ${r.symbol}${titleText r.title} ${reps}${params a r.params r.conts}${said} =\n  "
       in
       let v = stmt w a 1 r.body in
       put w "\n")

-- `roles { ... }` or `native { ... }`: a binding to a line.
fun table w (word : String) (keys : [String]) (values : [String]) =
  let u = put w "${word} {\n" in
  let v = V.foldl (\x kv -> put w "  ${fst kv} = ${snd kv}\n") () (V.zip keys values) in
  put w "}\n"

fun paramText (a : CutArena) (p : CutParam) : String =
  "${cutParamName a p}: ${cutParamRep a p}${shownText (cutParamShown a p) (cutParamTy a p)}"

-- ` @"shown" "ty"`, what the source calls a binder, where it was said.
fun shownText (shown : String) (ty : String) : String =
  if S.isEmpty shown then ""
  else if S.isEmpty ty then " @${quoted shown}"
  else " @${quoted shown} ${quoted ty}"

-- ` @"title"`, what the source calls a declaration, where it was said.
fun titleText (title : String) : String = if S.isEmpty title then "" else " @${quoted title}"

fun params (a : CutArena) (ps : [CutParam]) (ks : [CutParam]) : String =
  "(${S.join ", " (V.map (paramText a) ps)}; ${S.join ", " (V.map (paramText a) ks)})"

-- ` ! {E, .. | e, ..}`, where a row was given: as `meadow_cut::print`
-- writes one, `{| e}` when it names no effects.
fun row (known : Bool) (effects : [String]) (vars : [String]) : String =
  if not known then ""
  else if V.isEmpty vars then " ! {${S.join ", " effects}}"
  else if V.isEmpty effects then " ! {| ${S.join ", " vars}}"
  else " ! {${S.join ", " effects} | ${S.join ", " vars}}"

-- A new line, set in as far as `depth` says -- to a point: the text is for
-- a reader that does not count its spaces, and a program nests far deeper
-- than a line is wide.
fun line (depth : Int) : String = "\n" ++ S.repeat "  " (min depth 12)

fun call w (a : CutArena) (depth : Int) (args : [CutProd]) (ks : [CutCons]) =
  let u = put w "(" in
  let v = between w ", " (\x -> prod w a depth x) args in
  let x = put w "; " in
  let y = between w ", " (\k -> cons w a depth k) ks in
  put w ")"

fun stmt w (a : CutArena) (depth : Int) (s : CutStmt) =
  match viewCutStmt a s with
  | CutStmtView.Cut r ->
      (let u = put w "<" in
       let v = prod w a depth r.prod in
       let x = put w " | " in
       let y = cons w a depth r.cons in
       put w ">")
  | CutStmtView.Invoke r -> (let u = put w r.symbol in call w a depth r.args r.conts)
  | CutStmtView.Prim r -> (let u = put w "prim ${r.op}" in call w a depth r.args r.conts)
  | CutStmtView.Perform r -> (let u = put w "perform ${r.op}" in call w a depth r.args [r.cont])
  | CutStmtView.Handle r ->
      let named = \n -> "${n}: ptr" in
      let u = put w "handle {" in
      let v =
        V.foldl
          (\x c ->
            (let y =
               put
                 w
                 "${line (depth + 1)}${cutClauseOp a c}(${S.join ", " (V.map (paramText a) (cutClauseParams a c))}; ${named (cutClauseResume a c)}, ${named (cutClauseK a c)}) =>${line (depth + 2)}"
             in
             let z = stmt w a (depth + 2) (cutClauseBody a c) in
             put w ";"))
          ()
          r.clauses
      in
      let x =
        put
          w
          "${line (depth + 1)}return(${paramText a r.ret}; ${named r.retK}) =>${line (depth + 2)}"
      in
      let y = stmt w a (depth + 2) r.retBody in
      let z = put w "${line depth}} in μ ${r.bodyK}.${line (depth + 1)}" in
      let q = stmt w a (depth + 1) r.body in
      let t = put w "${line depth}; " in
      cons w a depth r.cont
  | CutStmtView.Error r -> put w "error ${quoted r.message}"
  | CutStmtView.At r ->
      (let u = put w "@${r.source}:${show r.start}-${show r.upto} " in stmt w a depth r.body)

fun prod w (a : CutArena) (depth : Int) (p : CutProd) =
  match viewCutProd a p with
  | CutProdView.Var r -> put w r.name
  | CutProdView.Sym r -> put w r.symbol
  | CutProdView.Int r -> put w (show r.value)
  | CutProdView.Float r -> put w (show r.value)
  | CutProdView.Char r -> put w "'\\u{${hex r.code}}'"
  | CutProdView.Str r -> put w (quoted r.text)
  | CutProdView.Bool r -> put w (if r.value then "true" else "false")
  | CutProdView.Unit _ -> put w "unit"
  | CutProdView.Desc r -> put w "desc(${r.rep})"
  | CutProdView.Con r ->
      if V.isEmpty r.args then put w r.symbol
      else
        (let u = put w "${r.symbol}(" in
         let v = between w ", " (\x -> prod w a depth x) r.args in
         put w ")")
  | CutProdView.Tuple r ->
      (let u = put w "#tuple(" in
       let v = between w ", " (\x -> prod w a depth x) r.items in
       put w ")")
  | CutProdView.Array r ->
      (let u = put w "[" in
       let v = between w ", " (\x -> prod w a depth x) r.items in
       put w "]")
  | CutProdView.Record r ->
      (let u = put w "record { " in
       let v =
         between
           w
           ", "
           (\f -> (let x = put w "${fst f} = " in prod w a depth (snd f)))
           (V.zip r.labels r.values)
       in put w " }")
  | CutProdView.Mu r ->
      (let u = put w "μ ${r.k}.${line (depth + 1)}" in stmt w a (depth + 1) r.body)
  | CutProdView.Cocase r ->
      (let u = put w "cocase {" in
       let v =
         between
           w
           ";"
           (\m ->
             (let x =
                put
                  w
                  "${line (depth + 1)}${cutMethodName a m}${titleText (cutMethodTitle a m)}${params a (cutMethodParams a m) (cutMethodConts a m)}${row (cutMethodRowKnown a m) (cutMethodRowEffects a m) (cutMethodRowVars a m)} =>${line (depth + 2)}"
              in stmt w a (depth + 2) (cutMethodBody a m)))
           r.methods
       in put w "${line depth}}")

fun cons w (a : CutArena) (depth : Int) (c : CutCons) =
  match viewCutCons a c with
  | CutConsView.KVar r -> put w r.name
  | CutConsView.Halt _ -> put w "halt"
  | CutConsView.MuT r ->
      (let u = put w "μ̃ ${r.name}: ${r.rep}${shownText r.shown r.ty}.${line (depth + 1)}" in
       stmt w a (depth + 1) r.body)
  | CutConsView.Case r ->
      (let u = put w "case {" in
       let v =
         between
           w
           ";"
           (\arm ->
             (let pattern = cutCaseArmPattern a arm in
              let fields = cutCaseArmFields a arm in
              let taken =
                if V.isEmpty fields and pattern != "#tuple" then ""
                else "(${S.join ", " (V.map (paramText a) fields)})"
              in
              let x = put w "${line (depth + 1)}${pattern}${taken} =>${line (depth + 2)}" in
              stmt w a (depth + 2) (cutCaseArmBody a arm)))
           r.arms
       in put w "${line depth}}")
  | CutConsView.Call r -> (let u = put w r.method in call w a depth r.args r.conts)

-- A string as Cut writes one.
fun quoted (s : String) : String =
  "\""
    ++ S.join
      ""
      (V.map
         (\c ->
           if c == '"' then "\\\""
           else if c == '\\' then "\\\\"
           else if c == '\n' then "\\n"
           else if c == '\t' then "\\t"
           else if c == '\r' then "\\r"
           else C.toString c)
         (S.chars s))
    ++ "\""

fun hex (n : Int) : String =
  if n < 16 then stringSlice "0123456789abcdef" n (n + 1) else hex (n / 16) ++ hex (n % 16)

-- Definitions that make an `i64` its digits, in `package`: what `answer str`
-- needs of a whole number, since a runtime turns nothing into text but text.
-- Text, to follow a program's, until there is a way to say them as nodes.
@pub fun showInt (package : String) : String = "
def ${package}\"#showInt\" (n: i64; k: ptr) =
  prim lt(n, 0; μ̃ u: unit. ${package}\"#showNat\"(n; k), μ̃ u: unit. prim sub(0, n; μ̃ m: i64. ${package}\"#showNat\"(m; μ̃ s: str. prim concatStrings([\"-\", s]; k))))

def ${package}\"#showNat\" (n: i64; k: ptr) =
  prim lt(n, 10; μ̃ u: unit. prim div(n, 10; μ̃ q: i64. ${package}\"#showNat\"(q; μ̃ hi: str. prim mod(n, 10; μ̃ r: i64. ${package}\"#digit\"(r; μ̃ d: str. prim concatStrings([hi, d]; k))))), μ̃ u: unit. ${package}\"#digit\"(n; k))

def ${package}\"#digit\" (d: i64; k: ptr) =
  prim add(d, 1; μ̃ e: i64. prim stringSlice(\"0123456789\", d, e; k))
"

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq)

-- The smallest program `meadow cut` runs: an entry that gives its
-- continuation a string, which is the program's answer.
@test fun aProgramIsWrittenAsMeadowCutReadsIt () =
  let written =
    runSt (\() ->
      let out = builder () in
      let body = give out nowhere (str out nowhere "hi") (cont out nowhere "k") in
      let main = defDecl out nowhere "test:Main/main" [] [param out nowhere "k" "ptr"] body in
      text (finished out (file out nowhere "test:Main/main" "str" [main])))
  in assertEq
       written
       "cut 0\nentry test:Main/main\nanswer str\n\ndef test:Main/main (; k: ptr) =\n  <\"hi\" | k>\n"
       "the program's text"

-- What a front end with generics, `@many` operations, roles and natives
-- writes, in the order `meadow_cut::parse` takes declarations.
@test fun everyDeclarationIsWrittenAsMeadowCutReadsIt () =
  let written =
    runSt (\() ->
      let out = builder () in
      let m = nowhere in
      let list =
        dataDecl out m "test:Main/List" ["'a"] [
          ctorDecl out m "Nil" [],
          ctorDecl out m "Cons" ["'a", "ptr"]
        ]
      in
      let roles =
        rolesDecl out m [("nil", "test:Main/List.Nil"), ("cons", "test:Main/List.Cons")]
      in
      let native = nativeDecl out m [("test:Main/Out.say", "Console.writeOutput")] in
      let choose =
        effectDecl out m "test:Main/Choose" [
          manyOpDecl out m "choose" ["unit"] "bool",
          opDecl out m "flip" ["i64"] "unit"
        ]
      in
      let ident =
        defWith
          out
          m
          "test:Main/id"
          [("a_5", "d_a_4")]
          [("e_3", "Effect"), ("f_9", "ManyEffect")]
          [param out m "d_a_4" "desc", param out m "x" "'a_5"]
          [param out m "k" "ptr"]
          (give out m (var out m "x") (cont out m "k"))
      in
      let pure =
        defWith
          out
          m
          "test:Main/all"
          []
          [("e", "ManyEffect")]
          []
          [param out m "k" "ptr"]
          (give out m (unit out m) (cont out m "k"))
      in text
           (finished
              out
              (file out m "test:Main/all" "none" [list, roles, native, choose, ident, pure])))
  in assertEq
       written
       (S.join "\n" [
          "cut 0", "entry test:Main/all", "answer none", "",
          "data test:Main/List <'a> { Nil; Cons('a, ptr) }", "", "roles {",
          "  nil = test:Main/List.Nil", "  cons = test:Main/List.Cons", "}", "", "native {",
          "  test:Main/Out.say = Console.writeOutput", "}", "",
          "effect test:Main/Choose { @many choose(unit) -> bool; flip(i64) -> unit }", "",
          "def test:Main/id <'a_5 = d_a_4; e_3: Effect, f_9: ManyEffect> (d_a_4: desc, x: 'a_5; k: ptr) =",
          "  <x | k>", "", "def test:Main/all <e: ManyEffect> (; k: ptr) =", "  <unit | k>", ""
        ])
       "the program's text"

-- A row in each of its forms, on a definition and on a method, written as
-- `meadow_cut::parse` reads it: effects and variables, variables alone, and
-- nothing at all -- and no row, which says nothing.
@test fun aRowIsWrittenAsMeadowCutReadsIt () =
  let written =
    runSt (\() ->
      let out = builder () in
      let m = nowhere in
      let k = [param out m "k" "ptr"] in
      let answer = give out m (int out m 1) (cont out m "k") in
      let both =
        defWithRow
          out
          m
          "test:Main/both"
          []
          [("e1", "Effect"), ("e2", "ManyEffect")]
          []
          k
          ["test:Main/Ask", "test:Main/Choose"]
          ["e1", "e2"]
          answer
      in
      let vars = defWithRow out m "test:Main/vars" [] [("e", "Effect")] [] k [] ["e"] answer in
      let pure =
        defWithRow
          out
          m
          "test:Main/pure"
          []
          []
          []
          k
          []
          []
          (give
             out
             m
             (cocase out m [
                methodWithRow
                  out
                  m
                  "apply"
                  [param out m "x" "i64"]
                  [param out m "j" "ptr"]
                  ["test:Main/Ask"]
                  []
                  (give out m (var out m "x") (cont out m "j")),
                method
                  out
                  m
                  "other"
                  []
                  [param out m "j" "ptr"]
                  (give out m (int out m 2) (cont out m "j"))
              ])
             (cont out m "k"))
      in
      -- A row names only declared effects.
      let ask = effectDecl out m "test:Main/Ask" [opDecl out m "ask" ["unit"] "i64"] in
      let choose =
        effectDecl out m "test:Main/Choose" [manyOpDecl out m "choose" ["unit"] "bool"]
      in text (finished out (file out m "test:Main/pure" "none" [ask, choose, both, vars, pure])))
  in assertEq
       written
       (S.join "\n" [
          "cut 0", "entry test:Main/pure", "answer none", "",
          "effect test:Main/Ask { ask(unit) -> i64 }", "",
          "effect test:Main/Choose { @many choose(unit) -> bool }", "",
          "def test:Main/both <e1: Effect, e2: ManyEffect> (; k: ptr) ! {test:Main/Ask, test:Main/Choose | e1, e2} =",
          "  <1 | k>", "", "def test:Main/vars <e: Effect> (; k: ptr) ! {| e} =", "  <1 | k>", "",
          "def test:Main/pure (; k: ptr) ! {} =", "  <cocase {",
          "    apply(x: i64; j: ptr) ! {test:Main/Ask} =>", "      <x | j>;",
          "    other(; j: ptr) =>", "      <2 | j>", "  } | k>", ""
        ])
       "the program's text"

-- A local function's method, with what the source calls the function.
@test fun aTitledMethodIsWrittenAsMeadowCutReadsIt () =
  let written =
    runSt (\() ->
      let out = builder () in
      let m = nowhere in
      let f =
        cocase
          out
          m
          [titledMethod
             out
             m
             "apply"
             "mainLocal1"
             [param out m "x" "i64"]
             [param out m "j" "ptr"]
             (give out m (var out m "x") (cont out m "j"))]
      in
      let main =
        defDecl out m "test:Main/main" [] [param out m "k" "ptr"] (give out m f (cont out m "k"))
      in text (finished out (file out m "test:Main/main" "none" [main])))
  in assertEq
       written
       (S.join "\n" [
          "cut 0", "entry test:Main/main", "answer none", "", "def test:Main/main (; k: ptr) =",
          "  <cocase {", "    apply @\"mainLocal1\"(x: i64; j: ptr) =>", "      <x | j>",
          "  } | k>", ""
        ])
       "the program's text"

-- A program built to be debugged: the file its positions are in, a
-- statement at a position, binders and a definition with what the source
-- calls them -- as `meadow_cut::parse` reads them.
@test fun positionsAndNamesAreWrittenAsMeadowCutReadsThem () =
  let written =
    runSt (\() ->
      let out = builder () in
      let m = nowhere in
      let src = "test:Main/\"src/Main.mw\"" in
      let source = sourceDecl out m src "/home/t/src/Main.mw" in
      let body =
        at
          out
          m
          src
          15
          20
          (give
             out
             m
             (var out m "v3")
             (shownBinding
                out
                m
                "y"
                "i64"
                "twice"
                "Int"
                (give out m (var out m "y") (cont out m "k"))))
      in
      let double =
        titled
          out
          "double"
          (defDecl
             out
             m
             "test:Main/d1f"
             [shownParam out m "v3" "i64" "x" "Int"]
             [param out m "k" "ptr"]
             body)
      in
      let answer =
        titled
          out
          "answer"
          (valDecl out m "test:Main/d2" "i64" (give out m (int out m 1) (halt out m)))
      in text (finished out (file out m "test:Main/d1f" "none" [source, double, answer])))
  in assertEq
       written
       (S.join "\n" [
          "cut 0", "entry test:Main/d1f", "answer none", "",
          "source test:Main/\"src/Main.mw\" = \"/home/t/src/Main.mw\"", "",
          "def test:Main/d1f @\"double\" (v3: i64 @\"x\" \"Int\"; k: ptr) =",
          "  @test:Main/\"src/Main.mw\":15-20 <v3 | μ̃ y: i64 @\"twice\" \"Int\".", "    <y | k>>",
          "", "val test:Main/d2 @\"answer\" : i64 =", "  <1 | halt>", ""
        ])
       "the program's text"
